{
  "name": "@cortex/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Cortex desktop application",
  "author": "Howard Thomas",
  "main": "./out/main/index.js",
  "scripts": {
    "build": "pnpm typecheck && electron-vite build",
    "dev": "electron-vite dev",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "package:dir": "pnpm build && electron-builder --dir --mac",
    "package:mac": "pnpm build && electron-builder --mac dmg",
    "postinstall": "electron-builder install-app-deps",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false"
  },
  "dependencies": {
    "@electron-toolkit/utils": "4.0.0",
    "@fontsource/dm-mono": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.31",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "3.1.0",
    "@electron-toolkit/tsconfig": "2.0.0",
    "@tanstack/router-plugin": "1.168.34",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "9.39.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "jsdom": "27.2.0",
    "prettier": "3.7.4",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
